#!/bin/sh
# Conventional Commits: type(scope): subject   e.g. feat(auth): add Google sign-in
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}'
if ! head -1 "$1" | grep -Eq "$re" && ! head -1 "$1" | grep -Eq '^(Merge|Revert) '; then
  echo "Commit message must look like: feat(scope): short description" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
